{
  "name": "redline-pdf",
  "productName": "Redline PDF",
  "version": "0.11.0",
  "description": "Fast PDF markup tool for electrical drawings - highlight, redline, measure, and compare revisions.",
  "main": "main.js",
  "author": "Robbuie",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/verify.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.robbuie.redlinepdf",
    "productName": "Redline PDF",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/pdfjs-dist/build/**/*",
      "node_modules/pdfjs-dist/legacy/build/**/*",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*",
      "node_modules/pdfjs-dist/iccs/**/*",
      "node_modules/pdfjs-dist/web/images/**/*",
      "node_modules/pdf-lib/dist/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/semver/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "RedlinePDF.Document",
          "description": "PDF Document",
          "role": "Editor"
        }
      ]
    },
    "portable": {
      "artifactName": "Redline-PDF-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "Redline-PDF-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Redline PDF"
    }
  }
}
